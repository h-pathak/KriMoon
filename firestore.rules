rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Hardened Global Primitives ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidCoupleCode(code) {
      return code is string && code.size() == 6 && code.matches('^[0-9]{6}$');
    }

    function isValidPublicKey(k) {
      return k is string && k.size() <= 256 && k.matches('^[A-Za-z0-9+/=\\-_]*$');
    }

    function isValidMemberUids(uids) {
      return uids is list &&
             uids.size() >= 1 &&
             uids.size() <= 2 &&
             uids[0] is string && uids[0].size() >= 1 && uids[0].size() <= 128 &&
             (uids.size() == 1 || (uids[1] is string && uids[1].size() >= 1 && uids[1].size() <= 128 && uids[1] != uids[0]));
    }

    // --- Entity Validation Blueprints (Anti-Update-Gap + ECDH Public Key Validation) ---
    function isValidCoupleRoom(d) {
      return isValidCoupleCode(d.coupleCode) &&
             d.creatorUid is string && d.creatorUid.size() >= 1 && d.creatorUid.size() <= 128 &&
             d.creatorName is string && d.creatorName.size() >= 1 && d.creatorName.size() <= 32 &&
             isValidPublicKey(d.creatorPublicKey) &&
             d.partnerUid is string && d.partnerUid.size() <= 128 &&
             d.partnerName is string && d.partnerName.size() <= 32 &&
             isValidPublicKey(d.partnerPublicKey) &&
             d.pendingPartnerUid is string && d.pendingPartnerUid.size() <= 128 &&
             d.pendingPartnerName is string && d.pendingPartnerName.size() <= 32 &&
             isValidPublicKey(d.pendingPartnerPublicKey) &&
             isValidMemberUids(d.memberUids) &&
             d.spiceLevel in ['SWEET', 'FLIRTY', 'BOLD'] &&
             d.status in ['WAITING', 'PENDING_APPROVAL', 'CONNECTED', 'UNPAIRED'] &&
             d.blockCount is int && d.blockCount >= 0 && d.blockCount <= 100000 &&
             d.latestBlockHash is string && d.latestBlockHash.size() <= 128 &&
             d.createdAt is timestamp &&
             d.updatedAt is timestamp;
    }

    function isValidCoupleBlock(d, expectedCoupleCode) {
      return d.coupleCode is string &&
             d.coupleCode == expectedCoupleCode &&
             d.senderUid is string && d.senderUid.size() >= 1 && d.senderUid.size() <= 128 &&
             d.senderName is string && d.senderName.size() >= 1 && d.senderName.size() <= 32 &&
             isValidMemberUids(d.memberUids) &&
             d.blockIndex is int && d.blockIndex >= 0 && d.blockIndex <= 100000 &&
             d.actionType in [
               'GENESIS_BOND', 'HANDSHAKE', 'QUIZ', 'WYR', 'DOODLE', 'TTT',
               'DARE', 'WAVELENGTH', 'WHISPER', 'UNPAIR'
             ] &&
             d.blockHash is string && d.blockHash.size() >= 8 && d.blockHash.size() <= 128 &&
             d.encryptedPacket is string &&
             d.encryptedPacket.size() >= 20 &&
             d.encryptedPacket.size() <= 65536 &&
             d.encryptedPacket.matches('^KRIMOON:BCHAIN:[A-Za-z0-9+/=\\-_]+$') &&
             d.createdAt is timestamp;
    }

    // Concise transition checks preventing MITM key substitution, self-approval, and rollback
    function canRequestJoin(ext, inc, changed) {
      return ext.status == 'WAITING' &&
             ext.memberUids.size() == 1 &&
             ext.partnerUid == '' &&
             ext.pendingPartnerUid == '' &&
             inc.memberUids == ext.memberUids &&
             inc.partnerUid == '' &&
             inc.partnerName == ext.partnerName &&
             inc.partnerPublicKey == ext.get('partnerPublicKey', '') &&
             inc.pendingPartnerUid == request.auth.uid &&
             inc.pendingPartnerName.size() >= 1 &&
             inc.status == 'PENDING_APPROVAL' &&
             changed.hasOnly([
               'pendingPartnerUid', 'pendingPartnerName', 'pendingPartnerPublicKey', 'status', 'updatedAt'
             ]);
    }

    function canApprovePending(ext, inc, changed) {
      return request.auth.uid == ext.creatorUid &&
             ext.status == 'PENDING_APPROVAL' &&
             ext.pendingPartnerUid != '' &&
             ext.pendingPartnerName.size() >= 1 &&
             ext.memberUids.size() == 1 &&
             inc.pendingPartnerUid == '' &&
             inc.pendingPartnerName == '' &&
             inc.pendingPartnerPublicKey == '' &&
             inc.partnerName == ext.pendingPartnerName &&
             inc.partnerPublicKey == ext.get('pendingPartnerPublicKey', '') &&
             inc.status == 'CONNECTED' &&
             (
               (ext.pendingPartnerUid != ext.creatorUid &&
                inc.partnerUid == ext.pendingPartnerUid &&
                inc.memberUids.size() == 2 &&
                inc.memberUids[0] == ext.creatorUid &&
                inc.memberUids[1] == ext.pendingPartnerUid) ||
               (ext.pendingPartnerUid == ext.creatorUid &&
                inc.partnerUid == '' &&
                inc.memberUids == ext.memberUids)
             ) &&
             changed.hasOnly([
               'partnerUid', 'partnerName', 'partnerPublicKey', 'memberUids',
               'pendingPartnerUid', 'pendingPartnerName', 'pendingPartnerPublicKey',
               'status', 'updatedAt'
             ]);
    }

    function canDeclineOrCancel(ext, inc, changed) {
      return (request.auth.uid == ext.creatorUid || request.auth.uid == ext.pendingPartnerUid) &&
             ext.status == 'PENDING_APPROVAL' &&
             inc.memberUids == ext.memberUids &&
             inc.partnerUid == ext.partnerUid &&
             inc.partnerName == ext.partnerName &&
             inc.partnerPublicKey == ext.get('partnerPublicKey', '') &&
             inc.pendingPartnerUid == '' &&
             inc.pendingPartnerName == '' &&
             inc.pendingPartnerPublicKey == '' &&
             inc.status == 'WAITING' &&
             changed.hasOnly([
               'pendingPartnerUid', 'pendingPartnerName', 'pendingPartnerPublicKey', 'status', 'updatedAt'
             ]);
    }

    function canSyncRoomMeta(ext, inc, changed) {
      return request.auth.uid in ext.memberUids &&
             inc.memberUids == ext.memberUids &&
             inc.partnerUid == ext.partnerUid &&
             inc.partnerName == ext.partnerName &&
             inc.partnerPublicKey == ext.get('partnerPublicKey', '') &&
             inc.pendingPartnerUid == ext.pendingPartnerUid &&
             inc.pendingPartnerName == ext.pendingPartnerName &&
             inc.pendingPartnerPublicKey == ext.get('pendingPartnerPublicKey', '') &&
             inc.status == ext.status &&
             inc.blockCount >= ext.blockCount &&
             changed.hasOnly([
               'spiceLevel', 'blockCount', 'latestBlockHash', 'updatedAt'
             ]);
    }

    function canUnpairRoom(ext, inc, changed) {
      return request.auth.uid in ext.memberUids &&
             inc.memberUids == ext.memberUids &&
             inc.partnerUid == ext.partnerUid &&
             inc.partnerName == ext.partnerName &&
             inc.partnerPublicKey == ext.get('partnerPublicKey', '') &&
             inc.pendingPartnerUid == '' &&
             inc.pendingPartnerName == '' &&
             inc.pendingPartnerPublicKey == '' &&
             inc.status == 'UNPAIRED' &&
             changed.hasOnly([
               'status', 'pendingPartnerUid', 'pendingPartnerName', 'pendingPartnerPublicKey', 'updatedAt'
             ]);
    }

    function canUpdateRoom(coupleCode) {
      let ext = resource.data;
      let inc = request.resource.data;
      let changed = inc.diff(ext).affectedKeys();
      return isSignedIn() &&
             isValidCoupleCode(coupleCode) &&
             ext.status != 'UNPAIRED' &&
             inc.coupleCode == ext.coupleCode &&
             inc.creatorUid == ext.creatorUid &&
             inc.creatorName == ext.creatorName &&
             inc.creatorPublicKey == ext.get('creatorPublicKey', '') &&
             inc.createdAt == ext.createdAt &&
             inc.updatedAt <= request.time &&
             isValidCoupleRoom(inc) && (
               canRequestJoin(ext, inc, changed) ||
               canApprovePending(ext, inc, changed) ||
               canDeclineOrCancel(ext, inc, changed) ||
               canSyncRoomMeta(ext, inc, changed) ||
               canUnpairRoom(ext, inc, changed)
             );
    }

    function parentRoomAllowsBlock(coupleCode, blockMemberUids) {
      let roomDoc = get(/databases/$(database)/documents/coupleRooms/$(coupleCode));
      return roomDoc != null &&
             roomDoc.data.status != 'UNPAIRED' &&
             request.auth.uid in roomDoc.data.memberUids &&
             blockMemberUids == roomDoc.data.memberUids;
    }

    // --- Couple Rooms Collection ---
    match /coupleRooms/{coupleCode} {
      // Allow single-doc get for:
      // 1) Non-existent room lookup (verifying global code availability)
      // 2) Bonded members of this room
      // 3) Pending partner observing whether Host approved or declined their request
      // 4) Authenticated partner looking up an open WAITING 1-member room by exact 6-digit code
      allow get: if isSignedIn() &&
                    isValidCoupleCode(coupleCode) && (
                      resource == null ||
                      request.auth.uid in resource.data.memberUids ||
                      request.auth.uid == resource.data.pendingPartnerUid ||
                      (resource.data.status == 'WAITING' && resource.data.memberUids.size() == 1)
                    );

      // List strictly scoped to rooms where caller is a bonded member or pending requester
      allow list: if isSignedIn() && (
        request.auth.uid in resource.data.memberUids ||
        request.auth.uid == resource.data.pendingPartnerUid
      );

      // Create: authenticated Host reserves a globally unique, never-before-used 6-digit code
      // and pins their immutable ECDH P-256 public key.
      allow create: if isSignedIn() &&
                       isValidCoupleCode(coupleCode) &&
                       request.resource.data.keys().hasAll([
                         'coupleCode', 'creatorUid', 'creatorName', 'creatorPublicKey',
                         'partnerUid', 'partnerName', 'partnerPublicKey',
                         'pendingPartnerUid', 'pendingPartnerName', 'pendingPartnerPublicKey',
                         'memberUids', 'spiceLevel', 'status', 'blockCount', 'latestBlockHash',
                         'createdAt', 'updatedAt'
                       ]) &&
                       request.resource.data.keys().hasOnly([
                         'coupleCode', 'creatorUid', 'creatorName', 'creatorPublicKey',
                         'partnerUid', 'partnerName', 'partnerPublicKey',
                         'pendingPartnerUid', 'pendingPartnerName', 'pendingPartnerPublicKey',
                         'memberUids', 'spiceLevel', 'status', 'blockCount', 'latestBlockHash',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidCoupleRoom(request.resource.data) &&
                       request.resource.data.coupleCode == coupleCode &&
                       request.resource.data.creatorUid == request.auth.uid &&
                       request.resource.data.partnerUid == '' &&
                       request.resource.data.partnerName == '' &&
                       request.resource.data.partnerPublicKey == '' &&
                       request.resource.data.pendingPartnerUid == '' &&
                       request.resource.data.pendingPartnerName == '' &&
                       request.resource.data.pendingPartnerPublicKey == '' &&
                       request.resource.data.memberUids.size() == 1 &&
                       request.resource.data.memberUids[0] == request.auth.uid &&
                       request.resource.data.status == 'WAITING' &&
                       request.resource.data.createdAt <= request.time &&
                       request.resource.data.updatedAt <= request.time;

      allow update: if canUpdateRoom(coupleCode);

      // NEVER allow deleting a room document so a generated 6-digit code can never be reused.
      allow delete: if false;

      // --- Truly Immutable, Append-Only Encrypted Blockchain Blocks Subcollection ---
      match /blocks/{blockId} {
        allow get: if isSignedIn() &&
                      isValidCoupleCode(coupleCode) &&
                      isValidId(blockId) &&
                      request.auth.uid in resource.data.memberUids;

        // Client MUST query with .whereArrayContains("memberUids", uid)
        allow list: if isSignedIn() && request.auth.uid in resource.data.memberUids;

        allow create: if isSignedIn() &&
                         isValidCoupleCode(coupleCode) &&
                         isValidId(blockId) &&
                         request.resource.data.keys().hasAll([
                           'coupleCode', 'senderUid', 'senderName', 'memberUids',
                           'blockIndex', 'actionType', 'blockHash', 'encryptedPacket', 'createdAt'
                         ]) &&
                         request.resource.data.keys().hasOnly([
                           'coupleCode', 'senderUid', 'senderName', 'memberUids',
                           'blockIndex', 'actionType', 'blockHash', 'encryptedPacket', 'createdAt'
                         ]) &&
                         isValidCoupleBlock(request.resource.data, coupleCode) &&
                         request.resource.data.senderUid == request.auth.uid &&
                         request.auth.uid in request.resource.data.memberUids &&
                         request.resource.data.createdAt <= request.time &&
                         parentRoomAllowsBlock(coupleCode, request.resource.data.memberUids);

        // Immutable blockchain blocks cannot be mutated or deleted
        allow update: if false;
        allow delete: if false;
      }
    }
  }
}
